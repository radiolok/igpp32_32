CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=6144

# Scan interrupt must keep running while flash cache is off
CONFIG_GPTIMER_ISR_IRAM_SAFE=y

# Console on UART0 (the "UART" USB port); native USB is the data link
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_SECONDARY_NONE=y

# Safety: reboot straight away on panic, the bootloader hook blanks the panel
CONFIG_ESP_SYSTEM_PANIC_SILENT_REBOOT=y
CONFIG_ESP_TASK_WDT_CHECK_IDLE_TASK_CPU1=n

# Long file names on FAT
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
